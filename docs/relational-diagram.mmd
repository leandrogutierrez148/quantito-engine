erDiagram
    %% Relaciones de Especificación, Activos y Configuración
    EXPERIMENTS ||--o{ VARIANTS : "1:N (configura)"
    STRATEGIES ||--o{ VARIANTS : "1:N (define algoritmo)"
    ASSETS ||--o{ VARIANTS : "1:N (asigna instrumento)"

    %% Relaciones de Ciclo de Vida de Ejecución y Señales
    EXPERIMENTS ||--o{ EXECUTIONS : "1:N (ejecuta corridas)"
    EXECUTIONS ||--o{ EXECUTION_VARIANTS : "1:N (desglosa por variante)"
    VARIANTS ||--o{ EXECUTION_VARIANTS : "1:N (congela snapshot y evalúa)"
    EXECUTION_VARIANTS ||--o{ SIGNALS : "1:1..N (emite señal)"

    ASSETS {
        int_unsigned id PK
        varchar symbol UK "AAPL, MSFT, NVDA, BTCUSDT"
        varchar name "Apple Inc., Bitcoin Tether Spot, etc."
        varchar asset_type "EQUITY, ETF, CRYPTO, FOREX"
        varchar exchange "NASDAQ, NYSE_ARCA, BINANCE"
        varchar currency "USD, USDT"
        varchar status "ACTIVE, INACTIVE"
        datetime created_at
        datetime updated_at
    }

    EXPERIMENTS {
        int_unsigned id PK
        varchar name "Nombre del experimento"
        varchar description "Descripción opcional"
        varchar status "DRAFT, ACTIVE, PAUSED, COMPLETED"
        varchar execution_mode "BACKTEST, PAPER, LIVE"
        datetime start_date
        datetime end_date
        varchar frequency "15m, 1h, 2h, 1d"
        decimal max_capital "Capital máximo asignado (18,4)"
        varchar currency "USD, USDT"
        json params "Configuración opcional (benchmark, slippage, etc.)"
        text notes
        datetime created_at
        datetime updated_at
    }

    STRATEGIES {
        int_unsigned id PK
        varchar name "Nombre legible de la estrategia"
        varchar class "fifty_day_avg, price_momentum, clockwork_hgb"
        json param_definitions "Especificaciones de parámetros (tipos, defaults, required)"
        varchar status "ACTIVE, INACTIVE"
        datetime created_at
        datetime updated_at
    }

    VARIANTS {
        int_unsigned id PK
        int_unsigned experiment_id FK "REFERENCES experiments(id) ON DELETE CASCADE"
        int_unsigned strategy_id FK "REFERENCES strategies(id) ON DELETE RESTRICT"
        int_unsigned asset_id FK "REFERENCES assets(id) ON DELETE RESTRICT"
        varchar name "Ej. AAPL - 50-Day SMA"
        json params "Parámetros actuales de la variante (mutables en el tiempo)"
        decimal max_capital_pct "Porcentaje máximo de capital (5,4), default 1.0000"
        int_unsigned max_attempts "Máximo de intentos de evaluación, default 3"
        varchar status "ACTIVE, INACTIVE"
        text notes
        datetime created_at
        datetime updated_at
    }

    EXECUTIONS {
        int_unsigned id PK
        int_unsigned experiment_id FK "REFERENCES experiments(id) ON DELETE CASCADE"
        varchar trigger_type "MANUAL, SCHEDULED, BACKTEST, WEBHOOK"
        varchar triggered_by "Usuario o sistema que disparó la corrida"
        datetime as_of_time "Timestamp de corte de evaluación"
        varchar status "PENDING, RUNNING, COMPLETED, PARTIAL_SUCCESS, FAILED"
        datetime started_at
        datetime completed_at
        text error_message
        datetime created_at
        datetime updated_at
    }

    EXECUTION_VARIANTS {
        int_unsigned id PK
        int_unsigned execution_id FK "REFERENCES executions(id) ON DELETE CASCADE (UK con variant_id)"
        int_unsigned variant_id FK "REFERENCES variants(id) ON DELETE CASCADE (UK con execution_id)"
        json params "Snapshot inmutable de params al momento de la ejecución"
        varchar status "PENDING, RUNNING, COMPLETED, FAILED"
        int_unsigned attempts "Cantidad de intentos realizados, default 0"
        int_unsigned duration_ms "Duración de evaluación en milisegundos"
        text error_message
        datetime started_at
        datetime completed_at
        datetime created_at
        datetime updated_at
    }

    SIGNALS {
        int_unsigned id PK
        int_unsigned execution_variant_id FK "REFERENCES execution_variants(id) ON DELETE CASCADE"
        varchar asset "Ticker del activo operado (VARCHAR 20)"
        varchar signal "BUY, HOLD, SELL"
        decimal price "Precio de referencia (18,4)"
        decimal confidence "Nivel de confianza (5,4), default 1.0000"
        datetime created_at
    }


