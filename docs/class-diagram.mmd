classDiagram
    direction TB

    %% ==========================================
    %% LAYER: CONTROLLERS & SERVICES
    %% ==========================================
    class ExecutionController {
        -service IExecutionService
        +Execute(c echo.Context) error
    }

    class IExecutionService {
        <<interface>>
        +Execute(id int) error
        +ExecuteWithDetails(id int, triggerType string, triggeredBy string, asOfTime time.Time) error
    }

    class ExecutionService {
        -experimentsRepo IExperimentsRepository
        -executionsRepo IExecutionsRepository
        -signalsRepo ISignalsRepository
        -strategyFactory IStrategyFactory
        -signalDispatcher ISignalDispatcher
        -executionMutex IExecutionMutex
        +Execute(id int) error
        +ExecuteWithDetails(id int, triggerType string, triggeredBy string, asOfTime time.Time) error
        -runExecution(experiment *Experiment, execution *Execution) error
        -getMaxAttempts(variant *Variant) int
        -mergeVariantParams(experiment *Experiment, variant *Variant) map[string]any
        -evaluateVariant(executionVariantID int, experiment *Experiment, variant *Variant, params map[string]any) error
    }

    ExecutionController --> IExecutionService
    IExecutionService <|.. ExecutionService

    %% ==========================================
    %% LAYER: STRATEGIES & FACTORY
    %% ==========================================
    class IStrategyFactory {
        <<interface>>
        +CreateStrategy(strategyClass string) IStrategy, error
    }

    class StrategyFactory {
        -apiClient IAPIClient
        +CreateStrategy(strategyClass string) IStrategy, error
    }

    class IStrategy {
        <<interface>>
        +GenerateSignal(asset string, params map[string]any) *Signal, error
    }

    class FiftyDayAvgStrategy {
        -apiClient IAPIClient
        +GenerateSignal(asset string, params map[string]any) *Signal, error
    }

    class PriceMomentumStrategy {
        +GenerateSignal(asset string, params map[string]any) *Signal, error
    }

    class ClockworkHGBStrategy {
        -apiClient IAPIClient
        +GenerateSignal(asset string, params map[string]any) *Signal, error
    }

    ExecutionService --> IStrategyFactory
    IStrategyFactory <|.. StrategyFactory
    StrategyFactory ..> IStrategy
    IStrategy <|.. FiftyDayAvgStrategy
    IStrategy <|.. PriceMomentumStrategy
    IStrategy <|.. ClockworkHGBStrategy

    %% ==========================================
    %% LAYER: SIGNAL SINKS & DISPATCHER
    %% ==========================================
    class ISignalDispatcher {
        <<interface>>
        +RegisterSink(sink ISignalSink)
        +Dispatch(signal *Signal) error
    }

    class SignalDispatcher {
        -sinks []ISignalSink
        +RegisterSink(sink ISignalSink)
        +Dispatch(signal *Signal) error
    }

    class ISignalSink {
        <<interface>>
        +Name() string
        +Send(signal *Signal) error
    }

    class ConsoleSink {
        +Name() string
        +Send(signal *Signal) error
    }

    ExecutionService --> ISignalDispatcher
    ISignalDispatcher <|.. SignalDispatcher
    SignalDispatcher o-- ISignalSink
    ISignalSink <|.. ConsoleSink

    %% ==========================================
    %% LAYER: REPOSITORIES & INFRASTRUCTURE
    %% ==========================================
    class IExperimentsRepository {
        <<interface>>
        +Find(includeInactive bool) []*Experiment, error
        +FindByID(experimentID int) *Experiment, error
        +FindByExperiment(experimentName string) *Experiment, error
    }
    class ExperimentsRepository {
        -db IDBHandler
        +Find(includeInactive bool) []*Experiment, error
        +FindByID(experimentID int) *Experiment, error
        +FindByExperiment(experimentName string) *Experiment, error
    }

    class IVariantsRepository {
        <<interface>>
        +FindByExperiment(experimentID int) []*Variant, error
    }
    class VariantsRepository {
        -db IDBHandler
        +FindByExperiment(experimentID int) []*Variant, error
    }

    class IExecutionsRepository {
        <<interface>>
        +CreateExecution(experimentID int, triggerType string, triggeredBy string, asOfTime time.Time) *Execution, error
        +UpdateExecution(executionID int, status string, errorMessage Nullable~string~) *Execution, error
        +CreateExecutionVariant(executionID int, variantID int, params map[string]any) *ExecutionVariant, error
        +UpdateExecutionVariant(id int, status string, attempts int, durationMs int, errorMessage Nullable~string~) *ExecutionVariant, error
        +FindByID(executionID int) *Execution, error
        +FindByExperiment(experimentID int, limit int) []*Execution, error
    }
    class ExecutionsRepository {
        -db IDBHandler
        +CreateExecution(experimentID int, triggerType string, triggeredBy string, asOfTime time.Time) *Execution, error
        +UpdateExecution(executionID int, status string, errorMessage Nullable~string~) *Execution, error
        +CreateExecutionVariant(executionID int, variantID int, params map[string]any) *ExecutionVariant, error
        +UpdateExecutionVariant(id int, status string, attempts int, durationMs int, errorMessage Nullable~string~) *ExecutionVariant, error
        +FindByID(executionID int) *Execution, error
        +FindByExperiment(experimentID int, limit int) []*Execution, error
    }

    class ISignalsRepository {
        <<interface>>
        +Save(executionVariantID int, asset string, signal *Signal) *SignalRecord, error
        +FindByExecution(executionID int) []*SignalRecord, error
        +FindByAsset(asset string, fromDate Nullable~Time~, toDate Nullable~Time~) []*SignalRecord, error
    }
    class SignalsRepository {
        -db IDBHandler
        +Save(executionVariantID int, asset string, signal *Signal) *SignalRecord, error
        +FindByExecution(executionID int) []*SignalRecord, error
        +FindByAsset(asset string, fromDate Nullable~Time~, toDate Nullable~Time~) []*SignalRecord, error
    }

    class IExecutionMutex {
        <<interface>>
        +Lock(experimentID int, variantID int, asset string)
        +Unlock(experimentID int, variantID int, asset string)
    }
    class ExecutionMutex {
        -mutex IKeyMutex
        +Lock(experimentID int, variantID int, asset string)
        +Unlock(experimentID int, variantID int, asset string)
    }

    class IDBHandler {
        <<interface>>
        +QueryScalar(query string, dest any, params ...any) error
        +QueryOne(query string, dest any, params ...any) error
        +QueryAll(query string, dest any, params ...any) error
        +QueryJson(query string, obj any) []byte, error
    }

    ExecutionService --> IExperimentsRepository
    ExecutionService --> IExecutionsRepository
    ExecutionService --> ISignalsRepository
    ExecutionService --> IExecutionMutex

    IExperimentsRepository <|.. ExperimentsRepository
    IVariantsRepository <|.. VariantsRepository
    IExecutionsRepository <|.. ExecutionsRepository
    ISignalsRepository <|.. SignalsRepository
    IExecutionMutex <|.. ExecutionMutex

    ExperimentsRepository --> IDBHandler
    VariantsRepository --> IDBHandler
    ExecutionsRepository --> IDBHandler
    SignalsRepository --> IDBHandler

    %% ==========================================
    %% LAYER: DOMAIN MODELS
    %% ==========================================
    class Asset {
        +int ID
        +string Symbol
        +string Name
        +string AssetType
        +Nullable~string~ Exchange
        +string Currency
        +string Status
        +time.Time CreatedAt
        +time.Time UpdatedAt
    }

    class Experiment {
        +int ID
        +string Name
        +Nullable~string~ Description
        +string Status
        +string ExecutionMode
        +Nullable~Time~ StartDate
        +Nullable~Time~ EndDate
        +string Frequency
        +float64 MaxCapital
        +string Currency
        +JSONColumn Params
        +Nullable~string~ Notes
        +Variant[] Variants
        +IsActive() bool
        +GetParam(key string) (any, bool)
    }

    class Strategy {
        +int ID
        +string Name
        +string Class
        +JSONColumn ParamDefinitions
        +string Status
    }

    class Variant {
        +int ID
        +int ExperimentID
        +int StrategyID
        +int AssetID
        +string Asset
        +string Name
        +JSONColumn Params
        +float64 MaxCapitalPct
        +int MaxAttempts
        +string Status
        +Nullable~string~ Notes
        +string StrategyName
        +string Class
        +JSONColumn ParamDefinitions
    }

    class Execution {
        +int ID
        +int ExperimentID
        +string TriggerType
        +string TriggeredBy
        +time.Time AsOfTime
        +string Status
        +time.Time StartedAt
        +Nullable~Time~ CompletedAt
        +Nullable~string~ ErrorMessage
        +ExecutionVariant[] Variants
    }

    class ExecutionVariant {
        +int ID
        +int ExecutionID
        +int VariantID
        +JSONColumn Params
        +string Status
        +int Attempts
        +int DurationMs
        +Nullable~string~ ErrorMessage
        +Nullable~Time~ StartedAt
        +Nullable~Time~ CompletedAt
    }

    class Signal {
        +string Asset
        +SignalType Type
        +float64 Price
        +time.Time Timestamp
        +string StrategyName
        +float64 Confidence
        +map Metadata
    }

    class SignalRecord {
        +int ID
        +int ExecutionVariantID
        +int ExecutionID
        +int VariantID
        +string VariantName
        +string Asset
        +SignalType Signal
        +float64 Price
        +float64 Confidence
        +time.Time CreatedAt
    }

    %% ==========================================
    %% DOMAIN MODEL RELATIONSHIPS
    %% ==========================================
    Experiment "1" *-- "many" Variant : Variants
    Experiment "1" *-- "many" Execution : Executions
    Variant "many" --> "1" Strategy : references
    Variant "many" --> "1" Asset : references
    Execution "1" *-- "many" ExecutionVariant : Variants
    ExecutionVariant "many" --> "1" Variant : snapshots & evaluates
    
    ExecutionVariant ..> Signal : produces (BUY | HOLD | SELL)
    SignalDispatcher ..> Signal : dispatches
    SignalsRepository ..> SignalRecord : records

